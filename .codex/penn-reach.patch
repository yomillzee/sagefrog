+import ast, html, sys, types, unittest
+from pathlib import Path
+from typing import Any
+from unittest.mock import patch
+try:
+    from google.ads.googleads.client import GoogleAdsClient
+except ModuleNotFoundError:
+    for name in ("google","google.ads","google.ads.googleads","google.ads.googleads.client","google.auth","google.auth.transport","google.auth.transport.requests","google.oauth2","google.oauth2.credentials","google.protobuf","google.protobuf.json_format"):
+        sys.modules.setdefault(name, types.ModuleType(name))
+    sys.modules["google.ads.googleads.client"].GoogleAdsClient = object
+    sys.modules["google.auth.transport.requests"].Request = object
+    sys.modules["google.oauth2.credentials"].Credentials = object
+    sys.modules["google.protobuf.json_format"].MessageToDict = lambda *args, **kwargs: {}
+try:
+    import httpx
+except ModuleNotFoundError:
+    httpx_stub = types.ModuleType("httpx"); httpx_stub.Client = object; httpx_stub.HTTPStatusError = RuntimeError; sys.modules["httpx"] = httpx_stub
+import google_ads_service, linkedin_service, meta_service
+def _load_pure_function(relative_path, function_name):
+    source = (Path(__file__).resolve().parents[1] / relative_path).read_text(encoding="utf-8")
+    node = next(n for n in ast.parse(source).body if isinstance(n, ast.FunctionDef) and n.name == function_name)
+    ns = {"Any": Any, "_esc": lambda value: html.escape(str(value), quote=True)}
+    exec(compile(ast.Module(body=[node], type_ignores=[]), relative_path, "exec"), ns)
+    return ns[function_name]
+campaign_explorer_content_html = _load_pure_function("dashboard/renderers/dashboard_renderer.py", "campaign_explorer_content_html")
+normalize_entity_row = _load_pure_function("dashboard/services/snapshot_metrics_service.py", "normalize_entity_row")
+class PennReachTests(unittest.TestCase):
+    def test_meta_reach_maps_to_normalized_reach(self):
+        with patch.object(meta_service, "_graph_get_all", side_effect=[[{}], [{"campaign_id":"1","campaign_name":"Penn","reach":"123"}]]):
+            payload = meta_service.account_performance("1", include_reach=True, access_token="token", env=object())
+        self.assertEqual(payload["campaigns"][0]["reach"], 123)
+    def test_linkedin_approximate_reach_maps_to_normalized_reach(self):
+        fields = linkedin_service._linkedin_reach_fields([{"approximateMemberReach":456}]); self.assertEqual(fields["reach"],456)
+    def test_google_unique_users_maps_to_normalized_reach(self):
+        row={"campaign":{"id":"1","name":"Penn","status":"ENABLED"},"metrics":{"unique_users":"789"}}
+        with patch.object(google_ads_service,"search",return_value=[row]) as search:
+            payload=google_ads_service.campaign_performance("1",include_reach=True)
+        self.assertIn("metrics.unique_users",search.call_args.args[1]); self.assertEqual(payload["campaigns"][0]["reach"],789)
+    def test_google_lower_levels_do_not_invent_reach(self):
+        row={"campaign":{"id":"1","name":"Penn"},"ad_group":{"id":"2","name":"Group","status":"ENABLED"},"metrics":{}}
+        with patch.object(google_ads_service,"search",return_value=[row]): payload=google_ads_service.adgroups_performance("1",include_reach=True)
+        normalized=normalize_entity_row(payload["adgroups"][0]); self.assertIsNone(normalized["reach"])
+    def test_campaign_explorer_has_one_reach_column(self):
+        rendered=campaign_explorer_content_html(show_segment_filters=True,show_reach=True); self.assertEqual(rendered.count(">Reach<span"),1)
+if __name__ == "__main__": unittest.main()
