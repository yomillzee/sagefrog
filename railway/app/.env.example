# Required for Custom GPT / public callers: set in Railway Variables
# If unset, /google-ads/* routes stay open (local dev only — set this in production).
API_KEY=

# Preferred names (Railway)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# API version header (Linkedin-Version). Use 202509 for adCampaignGroups; 202404 often 404s.
LINKEDIN_VERSION=202509

# Meta Marketing API (Business Manager — lists all client ad accounts)
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=1064007753695517
META_API_VERSION=v21.0

# Microsoft Advertising API — authorized via Google OAuth (Google is used only to
# authenticate the user; the Google access token is presented to the Microsoft
# Advertising API with an `IdentityProvider: Google` header + the developer token).
# Register the OAuth client in Google Cloud Console and add MICROSOFT_ADS_REDIRECT_URI
# there as an authorized redirect URI (it must match byte-for-byte). Then connect the
# Google account under a client's connector wizard (Connectors → Microsoft Ads).
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_OAUTH_PROVIDER=google
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REDIRECT_URI=
# Optional: set to "sandbox" to target the Bing Ads sandbox instead of production.
# MICROSOFT_ADS_ENVIRONMENT=production

# Also accepted (same as linkedin-ads-dashboard .env)
# GOOGLE_DEVELOPER_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_LOGIN_CUSTOMER_ID=

# GA4 BigQuery access (single-env-var credentials pattern)
# Railway: do NOT paste multiline JSON in the web UI (often truncates). Use base64
# of the whole key file (one line, no leading "{") OR minify to one line, OR
# `railway variables --set "GCP_SERVICE_ACCOUNT_JSON=$(cat key.json)"`.
GCP_SERVICE_ACCOUNT_JSON=
BQ_PROJECT_ID=
BQ_DATASET_ID=
# Optional: GA4 property id for warehouse account_id (defaults to BQ_DATASET_ID)
# GA4_PROPERTY_ID=

# Multi-client GA4 (different GCP projects). One-line JSON in Railway.
# Add credentials_env when a client should use its own base64 service account JSON.
# If credentials_env is omitted, the app falls back to GCP_SERVICE_ACCOUNT_JSON.
GA4_CLIENTS={"penn":{"label":"Penn Community Bank","bq_project_id":"penn-community-b-1699391543298","bq_dataset_id":"analytics_313855909","credentials_env":"GCP_CREDS_PENN_BASE64"}}
GCP_CREDS_PENN_BASE64=base64_encoded_service_account_json_here
GCP_CREDS_NIXON_BASE64=base64_encoded_service_account_json_here
GCP_CREDS_SYNERGISTIX_BASE64=base64_encoded_service_account_json_here
GCP_CREDS_SAGEFROG_BASE64=base64_encoded_service_account_json_here

# Railway API — lets the Admin page upload a service-account JSON and write it
# back as a Railway variable (base64) automatically (Admin → GCP service account
# credentials). Setting a variable redeploys this service. RAILWAY_API_TOKEN is an
# account or team token. The IDs come from the Railway service URL / `railway status`.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# Browser login (Postgres web_users table) — admin + client dashboards
# AUTH_SESSION_SECRET=          # random string; signs session cookies + OAuth connect links.
#                               # REQUIRED in production (no longer falls back to CRON_SECRET/API_KEY).
#                               # To migrate without logging users out, set it to your current CRON_SECRET value.
# AUTH_SESSION_HTTPS_ONLY=1     # set on Railway production
# AUTH_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=   # min 10 chars; creates first admin if none exist
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_LOGIN_LOCKOUT_SECONDS=900
# AUTH_INVITE_TTL_HOURS=72        # lifetime of an invite ("magic") link; clamped to 1..720.
#                                 # Admin > Users mints a single-use link to send a new user;
#                                 # they open it, set their own password, and land signed in.
#                                 # The link's absolute URL is built from PUBLIC_BASE_URL below.
# DISABLE_API_DOCS=1              # auto on Railway; set 0 to enable /docs locally on Railway

# OAuth Connect (dashboard settings) — app id/secret in env; tokens stored encrypted in Postgres
# PUBLIC_BASE_URL=https://sagefrog-production.up.railway.app
# OAUTH_TOKEN_ENCRYPTION_KEY=     # REQUIRED in production; dev falls back to AUTH_SESSION_SECRET
# Connect each platform in Settings (admin). Do not set refresh/access tokens in env.

# Penn dashboard (/dashboard/penn) — optional overrides; code defaults to Penn account IDs.
# Dashboards are session-only (sign in). The legacy ?key= share link and its
# DASHBOARD_SECRET have been retired — give viewers a client-role login instead.
# CRON_SECRET=                  # dedicated to the /internal/sync-* cron endpoints only
# DASHBOARD_MIN_REFRESH_SECONDS=0
# DASHBOARD_MIN_QUICK_REFRESH_SECONDS=0
# PENN_DASHBOARD={"label":"Penn Community Bank","google_customer_id":"1549971930","linkedin_account_id":"508590994","meta_account_id":"2581574002135957","ga4_client_key":"penn"}

# Web Mentions (Google Alerts RSS monitoring) — alerts are added per client from
# the Web Mentions page; the daily poll runs via CRON_SECRET on
# /internal/web-mentions/ingest-due (see railway/cron-sync-bq).
# WEB_MENTIONS_ENCRYPTION_KEY=    # encrypts stored feed URLs at rest; falls back to
#                                 # OAUTH_TOKEN_ENCRYPTION_KEY, then AUTH_SESSION_SECRET.
#                                 # With none set, feed URLs are stored in plaintext.
# WEB_MENTIONS_TIMEOUT_SECONDS=20 # per-feed HTTP timeout
# WEB_MENTIONS_MAX_ENTRIES=100    # entries read from one feed per run
# WEB_MENTIONS_ALLOW_ANY_FEED=1   # accept non-Google feed URLs (still no private hosts)
